# Earlier local-only projects (never committed)
archive/

# Dependencies
node_modules/

# Build output
.next/
.next-qa/
# Other dist dirs (NEXT_DIST_DIR=.next-<name>), e.g. a second dev or build beside a running one
.next-*/
out/
dist/
next-env.d.ts
*.tsbuildinfo
vite.config.js
vite.config.d.ts
vitest.config.js
vitest.config.d.ts
.vite/

# Logs
*.log
npm-debug.log*

# Local environment
.env
.env.*
!.env.example

# Local SQLite database (conversation history)
.data/

# Real business data (filed returns, order snapshots, agent state) - never commit
data/
state/

# Langflow flow backups written by langflow/install.py (may hold component settings)
langflow/backup-*.json

# macOS
.DS_Store

# Vercel CLI link
.vercel
__pycache__/

# Trigger.dev CLI build output
.trigger
