# Studio: server configuration. Copy to .env.local for development (gitignored); set real
# values in your host's environment for production. Only NEXT_PUBLIC_* values reach the
# browser, and those are public by design.

# --- Supabase (required) ---
# Local: `npm run db:start` prints these. Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key. It grants only what Row Level Security allows a signed-in user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production builds only: a personal access token (supabase.com/dashboard/account/tokens)
# that lets the build apply supabase/migrations before the new code goes live.
# SUPABASE_ACCESS_TOKEN=

# --- Agent provider ---
# mock: built-in development agent, labeled "Mock agent" everywhere in the UI.
# langflow: your Langflow flow (see "Connecting Langflow" in docs/development.md).
AGENT_PROVIDER=mock
# Fail a run after this long with no events from the agent (ms). Default 300000 (5 min).
AGENT_IDLE_TIMEOUT_MS=
# Mock only: "false" exercises the non-streaming path.
MOCK_STREAMING=

# --- Langflow (required when AGENT_PROVIDER=langflow) ---
LANGFLOW_BASE_URL=
LANGFLOW_API_KEY=
LANGFLOW_FLOW_ID=
# "false" if the flow's model doesn't stream tokens. Default true.
LANGFLOW_STREAM=
# Optional: the header your Langflow server trusts for end-user identity
# (its LANGFLOW_SERVING_END_USER_HEADER). Scopes Langflow's own chat memory per member.
LANGFLOW_END_USER_HEADER=
# JSON tweaks template with {{placeholders}} filled per run. langflow/install.py prints the
# one for a flow with the Studio components, e.g.
# {"WorkspaceContext-studio":{"workspace_context":"{{system_context}}"},"ChatInput-AbCdE":{"files":"{{files}}"}}
# Without a "{{files}}" entry, file attachments are turned off.
LANGFLOW_TWEAKS=

# --- Composio (optional; enables "Connect apps") ---
# A Composio *project* key (ak_…); the flow's Member Apps node uses the same one. Server-side only.
COMPOSIO_API_KEY=
# Apps offered for connection, keyed by toolkit slug, e.g.
# {"gmail":{"name":"Gmail","authConfigId":"ac_..."},"googlesheets":{"name":"Google Sheets","authConfigId":"ac_..."}}
COMPOSIO_TOOLKITS=
# Watches (optional; tasks that run when something happens in a connected app, docs/watches.md).
# The signing secret of the project's Composio webhook (scripts/composio-webhook.mjs prints it),
# and a Trigger.dev secret key (tr_prod_…) the webhook hands each event to the worker with.
# The key alone also hands a chat's long job (keep_going) to the worker, so it carries on with no
# page open; KEEP_GOING_WORKER=off leaves that to the page. Server-side only.
COMPOSIO_WEBHOOK_SECRET=
TRIGGER_SECRET_KEY=
KEEP_GOING_WORKER=

# --- Supermemory (optional; long-term memory) ---
# The app reads and writes memory itself, one namespace per workspace and per member, so
# the flow must not have its own Supermemory connection. Server-side only.
SUPERMEMORY_API_KEY=

# --- Rating feedback (optional) ---
# The LangSmith project the agent's runs are traced to. With a key, a member's thumbs up or
# down on a reply (reasons and note included) is attached to that run's trace as feedback
# "user_rating", so ratings can feed evals. Server-side only.
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Push notifications (optional) ---
# Lets a member watch the agent's browser on a call, view only: Studio takes a screenshot of
# the conversation's own browser server-side (src/lib/browser-view.ts). Also lets them take it
# over when the agent hands it to them (to sign in), and keeps their sign-ins for next time
# (src/lib/browser-signins.ts). The raw API key of the same Browserbase project the flow's
# Studio Browser uses. Server-side only; unset turns it off.
BROWSERBASE_API_KEY=
# Seals the logins and cards members save for the agent's browser (src/lib/secrets), on top of
# Supabase Vault. 32 random bytes, base64: `openssl rand -base64 32`. Losing it loses every saved
# login and card. Unset means members can still fill one in, once, but not save it.
CREDENTIALS_KEY=

# Lets members get a notification when a task finishes or needs their OK, on any device
# where they turned it on (on iPhone: after adding Studio to the Home Screen). Make a key
# pair with `npx web-push generate-vapid-keys`. The private key is server-side only; the
# public key is handed to the browser by /api/push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about these notifications: mailto: or https: URL.
VAPID_SUBJECT=

# --- Limits (optional) ---
LIMIT_RUNS_PER_MINUTE=10
LIMIT_RUNS_PER_WORKSPACE_PER_DAY=200
# Replies running at once per person, across all their agents (task runs are counted apart).
LIMIT_CONCURRENT_RUNS=5
# Task runs (scheduled or "Run now") per workspace per day, apart from chat.
LIMIT_TASK_RUNS_PER_WORKSPACE_PER_DAY=50
# Agent runs per day across ALL workspaces (protects the model bill with open sign-ups).
# Unset = no service-wide cap. Set this in production.
LIMIT_RUNS_SERVICE_PER_DAY=

# --- Live agent access ---
# Workspaces allowed to use a live agent (comma-separated workspace ids), or "*" for all.
# Unset = none. Use "*" once the flow has been through langflow/install.py (Member Apps,
# no shared memory or in-process Python); before that, a single-business flow would expose
# that business's connected apps to every account.
AGENT_LIVE_WORKSPACES=

# --- Production (Vercel) ---
# Set these in Vercel → Settings → Environment Variables (Production), not in a file. The
# build needs none of them; they're read at request time. Before the first deploy, check
# them without printing values (see docs/deploy-checklist.md):
#   npx vercel env pull .env.production.local --environment=production
#   npm run check:deploy-env
# Production expects AGENT_PROVIDER=langflow, an https Supabase/Langflow URL,
# AGENT_LIVE_WORKSPACES=*, and LIMIT_RUNS_SERVICE_PER_DAY set.

# --- Preview features (optional) ---
# Sign-in emails (comma-separated) that see features still in preview: Business Brain,
# /why investigations, and tasks. Unset = nobody. Server-side only.
PREVIEW_FEATURE_EMAILS=
# Sign-in emails that see only the voice preview (the Setup Call), on top of the ones above.
PREVIEW_VOICE_EMAILS=

# --- Voice calls (preview; see docs/voice.md) ---
# Voice is out of the app unless this is "on" (`npm run qa:serve` sets it): no calls, mic, voice
# notes, or voice choices for anyone, and the voice routes refuse. The rest below counts only then.
VOICE_ENABLED=
# "elevenlabs" needs every value below; "mock" is a labeled stand-in for QA (typed speech,
# captions, no audio; `npm run qa:serve` uses it). Unset = calls are off. Server-side only.
VOICE_PROVIDER=
# Needs Agents, Text to Speech, Speech to Text, and Voices (read) access.
ELEVENLABS_API_KEY=
# The one shared ElevenLabs agent, in custom-LLM mode, pointed at /api/voice/llm/v1/chat/completions.
ELEVENLABS_AGENT_ID=
# Signs each call's voice context (guardrail and persona) and keys the names voice clips are
# charged under. 32+ random characters:
#   openssl rand -hex 32
VOICE_SEAL_SECRET=
# The API key you give the ElevenLabs agent's custom LLM; ElevenLabs sends it to Studio. 24+ characters.
VOICE_LLM_SECRET=
# The OpenAI-compatible model the voice talks with (it only speaks; the agent does the work).
VOICE_LLM_BASE_URL=
VOICE_LLM_API_KEY=
VOICE_LLM_MODEL=
# Optional extra request fields for that model, as JSON. On OpenRouter, {"reasoning":{"enabled":false}}
# skips thinking so the voice answers in well under a second.
VOICE_LLM_EXTRA_BODY=
# Voice time per person per day (UTC; calls plus voice previews and notes) and the longest call,
# in seconds. Defaults 1800 and 1500.
LIMIT_VOICE_SECONDS_PER_DAY=
LIMIT_VOICE_CALL_SECONDS=
# Spoken approvals on calls: on unless "off". A member's report that one wasn't what they said
# turns them off for everyone until the spoken_approval_reports table is cleared (docs/voice.md).
VOICE_SPOKEN_APPROVALS=

# --- Dictation (the message box's mic) ---
# On for everyone wherever there's speech to text (ELEVENLABS_API_KEY above, needing Speech to
# Text access), even with VOICE_ENABLED off; "off" turns it off. The recording is turned into
# words and dropped. Seconds a person may dictate per day (UTC, with any other voice time); default 1800.
DICTATION=
LIMIT_DICTATION_SECONDS_PER_DAY=
