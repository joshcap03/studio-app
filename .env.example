# Sales tax agent — secrets only. Copy to .env (gitignored) and fill in.
# Non-secret configuration lives in the agent's config/profile files, not here.

# --- LLM (Fireworks, OpenAI-compatible) ---
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Leave blank to auto-pin a served model with good tool calling (verified live at setup).
FIREWORKS_MODEL=

# --- Email notifications (SMTP; Gmail app password works) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=

# --- Shopify Admin API (read-only scopes only) ---
SHOPIFY_SHOP=
# Path 1: long-lived token from the one-time authorization-code flow
SHOPIFY_ACCESS_TOKEN=
# Path 2: client-credentials (app and store in the same Shopify organization)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# LangSmith (optional). Add real values only to the gitignored .env.
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=
# Set a prompt name:commit or name:tag to opt into a managed version.
LANGSMITH_PROMPT_CONVERSATION=
LANGSMITH_PROMPT_GROUNDED=
LANGSMITH_PROMPT_GENERAL=
LANGSMITH_PROMPT_FILING=
LANGSMITH_PROMPT_CHAT=
