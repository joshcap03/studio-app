# Studio workspace — server-side configuration.
# Copy to .env.local for development (gitignored). In production, set these in your host's
# environment. None of these values are ever sent to the browser.

# --- Access control (required) ---
# The single password that unlocks the workspace. Use 12+ characters.
APP_PASSWORD=
# Signs session cookies. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# --- Agent backend ---
# "mock" runs the built-in development agent (clearly labeled in the UI).
# "http" uses src/lib/agent/http.ts, the adapter for your agent's API (needs its contract).
AGENT_ADAPTER=mock
# Base URL of your agent API (server-side only).
AGENT_API_URL=
# Credential for your agent API (server-side only).
AGENT_API_KEY=
# Fail a run if the agent sends nothing for this long (milliseconds). Default 120000.
AGENT_IDLE_TIMEOUT_MS=
# Mock only: set to "false" to exercise the non-streaming path.
MOCK_STREAMING=

# --- Storage ---
# SQLite file for conversation history. Default .data/workspace.db.
# On a host with an ephemeral filesystem, point this at a persistent volume.
DATABASE_PATH=
