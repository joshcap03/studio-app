# Studio: server configuration. Copy to .env.local for development (gitignored); set real
# values in your host's environment for production. Only NEXT_PUBLIC_* values reach the
# browser, and those are public by design.

# --- Supabase (required) ---
# Local: `npm run db:start` prints these. Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key. It grants only what Row Level Security allows a signed-in user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Agent provider ---
# mock: built-in development agent, labeled "Mock agent" everywhere in the UI.
# langflow: your Langflow flow (see "Connecting Langflow" in README.md).
AGENT_PROVIDER=mock
# Fail a run after this long with no events from the agent (ms). Default 300000 (5 min).
AGENT_IDLE_TIMEOUT_MS=
# Mock only: "false" exercises the non-streaming path.
MOCK_STREAMING=

# --- Langflow (required when AGENT_PROVIDER=langflow) ---
LANGFLOW_BASE_URL=
LANGFLOW_API_KEY=
LANGFLOW_FLOW_ID=
# "false" to call /run without ?stream=true. Default true.
LANGFLOW_STREAM=
# Optional: the header your Langflow server trusts for end-user identity
# (its LANGFLOW_SERVING_END_USER_HEADER). Scopes Langflow's own chat memory per member.
LANGFLOW_END_USER_HEADER=
# Optional JSON tweaks template with {{placeholders}} filled per run, e.g.
# {"Agent-AbCdE":{"system_prompt":"{{system_context}}"},"ComposioAPI-XyZ":{"entity_id":"{{composio_user_id}}"}}
LANGFLOW_TWEAKS=

# --- Composio (optional; enables "Connect apps") ---
# Same Composio project your agent uses. Server-side only.
COMPOSIO_API_KEY=
# Apps offered for connection, keyed by toolkit slug, e.g.
# {"gmail":{"name":"Gmail","authConfigId":"ac_..."},"googlesheets":{"name":"Google Sheets","authConfigId":"ac_..."}}
COMPOSIO_TOOLKITS=

# --- Limits (optional) ---
LIMIT_RUNS_PER_MINUTE=10
LIMIT_RUNS_PER_WORKSPACE_PER_DAY=200
LIMIT_CONCURRENT_RUNS=2

# --- Live agent access ---
# Workspaces allowed to use a live agent (comma-separated workspace ids), or "*" for all.
# Unset = none. Keep this narrow until the flow is tenant-aware (per-user tool connections,
# per-workspace memory): a shared single-business flow would otherwise expose that
# business's connected apps and memory to every account.
AGENT_LIVE_WORKSPACES=
